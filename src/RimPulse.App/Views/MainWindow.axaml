<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RimPulse.App.ViewModels"
        xmlns:diagnostics="using:RimPulse.Core.Diagnostics"
        x:Class="RimPulse.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RimPulse"
        Width="1180"
        Height="840"
        MinWidth="980"
        MinHeight="680"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Inter, Noto Sans, Cantarell, Ubuntu, DejaVu Sans">

  <!-- The credits overlay sits on top of the workspace, so the whole window is one overlay container. -->
  <Grid>

    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Header -->
      <Border Grid.Row="0"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="24,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="{DynamicResource AccentQuietBrush}"
                      BorderBrush="{DynamicResource AccentBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="7,2"
                      VerticalAlignment="Center">
                <SelectableTextBlock Text="RIMPULSE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <SelectableTextBlock Text="Build. Reload. Test. Repeat." Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
            <SelectableTextBlock Text="RimWorld development environment" Classes="h1" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <SelectableTextBlock Text="{Binding StatusMessage}"
                       Classes="caption"
                       MaxWidth="360"
                       TextWrapping="Wrap"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />
            <Button Content="Activity" Classes="quiet" Command="{Binding ToggleActivityLogCommand}" />
            <Button Content="Credits" Classes="quiet" Command="{Binding ToggleCreditsCommand}" />
            <Button Content="Re-scan" Classes="accent" Command="{Binding RescanCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Body -->
      <TabControl Grid.Row="1" Margin="24,20,24,20">
        <TabItem Header="Installations">
      <Grid ColumnDefinitions="430,*">

        <!-- Installations -->
        <Border Classes="panel">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock Text="RIMWORLD INSTALLATIONS" Classes="section" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding InstallationCountText}" Classes="caption" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
              <TextBox Text="{Binding CustomPathInput, Mode=TwoWay}"
                       PlaceholderText="Add an installation path, e.g. ~/GOG Games/RimWorld" />
              <Button Grid.Column="1"
                      Content="Add"
                      Classes="quiet"
                      Margin="8,0,0,0"
                      Command="{Binding AddCustomPathCommand}" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
              <ListBox ItemsSource="{Binding Installations}"
                       SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                       Background="Transparent"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:InstallationViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <SelectableTextBlock Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <SelectableTextBlock Text="{Binding Summary}" Classes="caption" />
                        <SelectableTextBlock Text="{Binding PathText}"
                                   Classes="caption mono"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="330"
                                   HorizontalAlignment="Left" />
                      </StackPanel>

                      <Border Grid.Column="1"
                              CornerRadius="9"
                              Padding="8,2"
                              VerticalAlignment="Top"
                              Margin="8,2,0,0"
                              Background="{DynamicResource AccentQuietBrush}"
                              IsVisible="{Binding IsReady}">
                        <SelectableTextBlock Text="Ready" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Border>

                      <Border Grid.Column="1"
                              CornerRadius="9"
                              Padding="8,2"
                              VerticalAlignment="Top"
                              Margin="8,2,0,0"
                              Background="{DynamicResource WarningQuietBrush}"
                              IsVisible="{Binding IsUnsupported}">
                        <SelectableTextBlock Text="UNSUPPORTED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                      </Border>

                      <Border Grid.Column="1"
                              CornerRadius="9"
                              Padding="8,2"
                              VerticalAlignment="Top"
                              Margin="8,2,0,0"
                              Background="{DynamicResource DangerQuietBrush}"
                              IsVisible="{Binding IsIncomplete}">
                        <SelectableTextBlock Text="INCOMPLETE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <SelectableTextBlock IsVisible="{Binding HasNoInstallations}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Margin="2,6,2,0"
                         VerticalAlignment="Top"
                         Text="Nothing detected yet. RimPulse searches Steam libraries, GOG folders and the RIMWORLD_DIR environment variable. Add a path above to point at a specific installation." />
            </Grid>

            <SelectableTextBlock Grid.Row="3"
                       IsVisible="{Binding HasEnvironmentOverride}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Text="{Binding EnvironmentOverrideDisplay}" />
          </Grid>
        </Border>

        <!-- Details -->
        <Border Grid.Column="1" Classes="panel" Margin="16,0,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

            <StackPanel Spacing="5">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <SelectableTextBlock Text="{Binding SelectedTitle}" Classes="h1" VerticalAlignment="Center" />

                <Border CornerRadius="9" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource AccentQuietBrush}" IsVisible="{Binding SelectedIsReady}">
                  <SelectableTextBlock Text="Ready" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                </Border>

                <Border CornerRadius="9" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource WarningQuietBrush}" IsVisible="{Binding SelectedIsUnsupported}">
                  <SelectableTextBlock Text="UNSUPPORTED VERSION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                </Border>

                <Border CornerRadius="9" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource DangerQuietBrush}" IsVisible="{Binding SelectedIsIncomplete}">
                  <SelectableTextBlock Text="INCOMPLETE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                </Border>
              </StackPanel>

              <SelectableTextBlock Text="{Binding SelectedSubtitle}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedDetails}" Margin="0,20,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetailRow">
                  <Grid ColumnDefinitions="180,*" Margin="0,4">
                    <SelectableTextBlock Text="{Binding Label}" Classes="caption" VerticalAlignment="Top" />
                    <SelectableTextBlock Grid.Column="1"
                               Text="{Binding Value}"
                               Classes="body mono"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0,20,0,0" IsVisible="{Binding SelectedHasProblems}">
              <SelectableTextBlock Text="PROBLEMS DETECTED" Classes="section" />
              <ItemsControl ItemsSource="{Binding SelectedProblems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProblemRow">
                    <SelectableTextBlock Text="{Binding Text}"
                               FontSize="12"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="10" Margin="0,20,0,0">
              <SelectableTextBlock Text="{Binding SelectionNote}" Classes="caption" TextWrapping="Wrap" />
              <Button Content="Remove path from list"
                      Classes="quiet"
                      HorizontalAlignment="Left"
                      Command="{Binding RemoveCustomPathCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
        </TabItem>
        <TabItem Header="Runtime">
          <Border Classes="panel" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <SelectableTextBlock Text="GAME PROCESS &amp; COMPANION" Classes="section" />
                <SelectableTextBlock Text="Setup is opt-in. Install creates a symbolic link in the selected game's Mods folder; linking a project does the same without changing the project itself. Reinstall the companion after a game update before an isolated launch." Classes="caption" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Install companion link" Classes="quiet" Margin="0,0,8,8" Command="{Binding InstallCompanionCommand}" />
                  <Button Content="Link selected project" Classes="quiet" Margin="0,0,8,8" Command="{Binding LinkDevelopmentProjectCommand}" />
                </WrapPanel>
                <SelectableTextBlock Text="{Binding RuntimeSetupStatus}" Classes="caption" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Launch RimWorld normally" Classes="quiet" Margin="0,0,8,8" Command="{Binding LaunchGameCommand}" />
                  <Button Content="Launch isolated development" Classes="accent" Margin="0,0,8,8" Command="{Binding LaunchDevelopmentCommand}" />
                </WrapPanel>
                <SelectableTextBlock Text="Experimental: isolated launch creates a NEW retained save/config profile with Core, the companion and the selected project. Link the project first if needed. RimPulse does not resolve dependencies or enable DLC; the game may enable newly discovered expansions. This is not a sandbox: logs, preferences and mods may still use shared files. Real-game behavior needs verification." Classes="caption" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding RuntimeStatus}" Classes="body" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding CompanionStatus}" Classes="body" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding RuntimeProjectStatus}" Classes="body" TextWrapping="Wrap" />
                <SelectableTextBlock Text="LOADED MODS — STARTUP SNAPSHOT" Classes="section" Margin="0,8,0,0" />
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding RuntimeModsText}" Classes="caption mono" />
                </ScrollViewer>
                <SelectableTextBlock Text="A connected companion reports a startup snapshot, not that every mod loaded successfully. No hot reload or testing map is implemented. Close the game normally to save; closing RimPulse leaves the game running." Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </TabItem>
        <TabItem Header="Mod project">
          <Border Classes="panel" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Spacing="5">
                <SelectableTextBlock Text="MOD PROJECT" Classes="section" />
                <SelectableTextBlock Text="Select an existing mod root. RimPulse reads it without modifying files." Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="340,*" Margin="0,14,0,0">

                <!-- Saved projects -->
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                  <TextBox Text="{Binding ProjectPathInput, Mode=TwoWay}" PlaceholderText="Path to mod directory" />
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Browse…" Classes="quiet" Click="OnBrowseProject" />
                    <Button Content="Add" Classes="accent" Command="{Binding AddProjectCommand}" />
                    <Button Content="Inspect / refresh" Classes="quiet" Command="{Binding InspectProjectCommand}" />
                  </StackPanel>

                  <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,16,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                      <SelectableTextBlock Text="SAVED PROJECTS" Classes="section" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding ProjectCountText}" Classes="caption" />
                    </Grid>
                    <ListBox Grid.Row="1"
                             Margin="0,8,0,0"
                             ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectRow">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <SelectableTextBlock Text="{Binding Title}"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                              <SelectableTextBlock Text="{Binding Detail}"
                                         Classes="caption mono"
                                         TextTrimming="CharacterEllipsis"
                                         MaxWidth="240"
                                         HorizontalAlignment="Left" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="9"
                                    Padding="7,1"
                                    VerticalAlignment="Top"
                                    Margin="6,2,0,0"
                                    Background="{DynamicResource DangerQuietBrush}"
                                    IsVisible="{Binding IsMissing}">
                              <SelectableTextBlock Text="{Binding MissingLabel}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <SelectableTextBlock Grid.Row="1"
                               IsVisible="{Binding HasNoProjects}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Text="No projects yet. Enter a mod root or use Browse…, then choose Add." />
                  </Grid>

                  <Button Grid.Row="3"
                          Content="Remove from list"
                          Classes="quiet"
                          HorizontalAlignment="Left"
                          Margin="0,10,0,0"
                          Command="{Binding RemoveProjectCommand}" />
                </Grid>

                <ScrollViewer Grid.Column="1" Margin="20,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                  <SelectableTextBlock Text="{Binding ProjectSummary}" Classes="caption" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding ProjectDetails}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DetailRow">
                        <Grid ColumnDefinitions="180,*" Margin="0,4">
                          <SelectableTextBlock Text="{Binding Label}" Classes="caption" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="body mono" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding ProjectProblems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProblemRow">
                        <SelectableTextBlock Text="{Binding Text}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <SelectableTextBlock Text="BUILD" Classes="section" Margin="0,8,0,0" />
                  <SelectableTextBlock Text="{Binding BuildTargetText}" Classes="caption" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Build mod" Classes="accent" Command="{Binding BuildProjectCommand}" />
                    <Button Content="Copy all errors"
                            Classes="quiet"
                            IsVisible="{Binding HasBuildDiagnostics}"
                            Command="{Binding CopyBuildDiagnosticsCommand}" />
                    <SelectableTextBlock Text="{Binding BuildStatus}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               MaxWidth="520"
                               HorizontalAlignment="Left" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding BuildCopyNotice}"
                                       Classes="caption"
                                       IsVisible="{Binding HasBuildCopyNotice}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentBrush}" />
                  <ItemsControl ItemsSource="{Binding BuildDetails}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DetailRow">
                        <Grid ColumnDefinitions="180,*" Margin="0,3">
                          <SelectableTextBlock Text="{Binding Label}" Classes="caption" VerticalAlignment="Top" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="caption mono" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding BuildDiagnostics}" IsVisible="{Binding HasBuildDiagnostics}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BuildDiagnosticRow">
                        <SelectableTextBlock Text="{Binding Display}"
                                   Classes="caption mono"
                                   TextWrapping="Wrap"
                                   Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <SelectableTextBlock Text="Compiles the mod's C# projects against the selected installation's assemblies. XML is validated for syntax only; nothing is reloaded into a running game yet." Classes="caption" TextWrapping="Wrap" />

                  <SelectableTextBlock Text="FILE MONITOR" Classes="section" Margin="0,8,0,0" />
                  <SelectableTextBlock Text="{Binding MonitorStatus}" Classes="caption" TextWrapping="Wrap" />
                  <SelectableTextBlock Text="Recent changes (latest 250). XML syntax is checked only; no build or reload is performed." Classes="caption" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding ProjectChanges}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectChangeRow">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="70,100,110,*" Margin="0,4">
                          <SelectableTextBlock Text="{Binding Time}" Classes="caption mono" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Category}" Classes="caption" />
                          <SelectableTextBlock Grid.Column="2" Text="{Binding Change}" Classes="caption" />
                          <SelectableTextBlock Grid.Column="3" Text="{Binding Path}" Classes="caption mono" TextWrapping="Wrap" />
                          <SelectableTextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Validation}" Classes="caption" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Border>
        </TabItem>
      </TabControl>

      <!-- Activity -->
      <Border Grid.Row="2"
              IsVisible="{Binding IsActivityLogVisible}"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="24,14">
        <Grid RowDefinitions="Auto,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <SelectableTextBlock Text="RECENT ACTIVITY" Classes="section" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding LogFilePath}" Classes="caption mono" />
          </Grid>

          <Border Grid.Row="1"
                  Margin="0,10,0,0"
                  Height="150"
                  Background="{DynamicResource CanvasBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,8">
            <ScrollViewer x:Name="ActivityLogScroller" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ActivityLog}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="diagnostics:LogEntry">
                    <Grid ColumnDefinitions="66,42,*" Margin="0,1">
                      <SelectableTextBlock Text="{Binding TimestampDisplay}" Classes="caption mono" />
                      <SelectableTextBlock Grid.Column="1"
                                 Text="{Binding LevelLabel}"
                                 Classes="caption mono"
                                 Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                      <SelectableTextBlock Grid.Column="2"
                                 Text="{Binding Message}"
                                 Classes="caption"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

    </Grid>

    <!-- Credits overlay: every referenced project and creator is listed here. -->
    <Border IsVisible="{Binding IsCreditsOpen}" Background="#D90A0D12">
      <Border Classes="panel"
              Margin="48"
              MaxWidth="960"
              MaxHeight="720"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto">

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <SelectableTextBlock Text="Credits and references" Classes="h1" />
              <SelectableTextBlock Classes="caption"
                         TextWrapping="Wrap"
                         Text="RimPulse is built in conversation with the RimWorld modding community. Every project consulted, and its creator, is listed below." />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Close"
                    Classes="quiet"
                    VerticalAlignment="Top"
                    Command="{Binding ToggleCreditsCommand}" />
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Credits}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CreditEntryViewModel">
                  <Border BorderBrush="{DynamicResource PanelBorderBrush}"
                          BorderThickness="0,0,0,1"
                          Padding="0,14">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <SelectableTextBlock Text="{Binding ProjectName}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalAlignment="Center" />
                          <SelectableTextBlock Text="{Binding CreatorLine}" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <Border Background="{DynamicResource AccentQuietBrush}"
                                  CornerRadius="9"
                                  Padding="8,2"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsAttributed}">
                            <SelectableTextBlock Text="{Binding UsageLabel}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                          </Border>
                          <Button Content="{Binding PrimaryLinkLabel}"
                                  Classes="quiet"
                                  Padding="10,4"
                                  Command="{Binding OpenPrimaryLinkCommand}" />
                          <Button Content="{Binding RelatedLinkLabel}"
                                  Classes="quiet"
                                  Padding="10,4"
                                  IsVisible="{Binding HasRelatedUrl}"
                                  Command="{Binding OpenRelatedLinkCommand}" />
                        </StackPanel>
                      </Grid>

                      <SelectableTextBlock Grid.Row="1"
                                 Text="{Binding Summary}"
                                 Classes="caption"
                                 TextWrapping="Wrap"
                                 Margin="0,6,0,0" />

                      <SelectableTextBlock Grid.Row="2"
                                 Text="{Binding Relevance}"
                                 Classes="body"
                                 TextWrapping="Wrap"
                                 Margin="0,6,0,0" />

                      <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                        <SelectableTextBlock Text="{Binding LicenseText}" Classes="caption mono" />
                        <SelectableTextBlock Grid.Column="1"
                                   Text="{Binding UrlText}"
                                   Classes="caption mono"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="14,0,0,0" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Spacing="6" Margin="0,16,0,0">
            <SelectableTextBlock Text="ATTRIBUTION POLICY" Classes="section" />
            <SelectableTextBlock Text="{Binding AttributionPolicy}" Classes="caption" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding CreditsCountText}" Classes="caption" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

  </Grid>
</Window>
