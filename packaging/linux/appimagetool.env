#!/usr/bin/env bash
# Single source of truth for the appimagetool pin. Sourced (not executed) by fetch-appimagetool.sh and
# by the release workflow, so a local build and CI use exactly the same verified binary.
#
# Version 1.9.1 is a stable tag (unlike the mutable "continuous" release). The SHA-256 values below are
# the `digest` fields reported by the GitHub Releases API for those two assets; verify them again when
# bumping: gh api repos/AppImage/appimagetool/releases/tags/<tag> --jq '.assets[] | {name, digest}'
APPIMAGETOOL_VERSION="1.9.1"
APPIMAGETOOL_URL_X86_64="https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage"
APPIMAGETOOL_SHA256_X86_64="ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0"
APPIMAGETOOL_URL_AARCH64="https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-aarch64.AppImage"
APPIMAGETOOL_SHA256_AARCH64="f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158"
